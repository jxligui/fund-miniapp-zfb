/* 自选星标（★）—— 金色主题 */
.watch-star {
  font-size: 44rpx;
  color: #475569;
  line-height: 1;
  padding: 8rpx;
}
.watch-star-on { color: #f59e0b; }

/* 列表行右侧的自选开关（全部基金 / ETF） */
.fund-watch {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #1a2234;
}
.fund-watch-on { color: #f59e0b; background: rgba(245, 158, 11, 0.14); }

/* 加载失败诊断文字 */
.fail-reason {
  display: block;
  font-size: 22rpx;
  color: #ef4444;
  margin-top: 12rpx;
  line-height: 1.6;
  word-break: break-all;
  padding: 0 24rpx;
}
