.d-title { font-size: 34rpx; font-weight: 600; color: #f8fafc; }
.d-code { font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; }
.d-nav {
  font-size: 60rpx; font-weight: 700; margin-top: 20rpx;
  font-variant-numeric: tabular-nums; letter-spacing: -1rpx;
}
.d-date { font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; }
.d-section { font-size: 26rpx; color: #94a3b8; margin-bottom: 16rpx; }

.spans {
  display: flex; flex-wrap: wrap;
  margin-top: 24rpx; padding-top: 20rpx;
  border-top: 1rpx solid #334155;
}
.span { width: 33.33%; text-align: center; padding: 8rpx 0; }
.span-label { font-size: 22rpx; color: #94a3b8; }
.span-value { font-size: 28rpx; font-weight: 600; margin-top: 4rpx; font-variant-numeric: tabular-nums; }

.chart { margin-top: 12rpx; }
.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  height: 260rpx;
}
.chart-bar { flex: 1; border-radius: 4rpx 4rpx 0 0; min-height: 4rpx; }
.chart-axis {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}
