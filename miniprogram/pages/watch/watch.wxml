<view class="page">
  <view class="sub-tabs">
    <view class="sub-tab {{sub === 'index' ? 'on' : ''}}" data-sub="index" bindtap="switchSub">自选大盘指数</view>
    <view class="sub-tab {{sub === 'fund' ? 'on' : ''}}" data-sub="fund" bindtap="switchSub">自选基金</view>
  </view>

  <!-- 自选大盘指数 -->
  <block wx:if="{{sub === 'index'}}">
    <view class="card idx-card" wx:for="{{indices}}" wx:key="code">
      <view class="idx-head">
        <view>
          <view class="idx-name">{{item.name}}</view>
          <view class="idx-meta">{{item.code}} · {{item.category}}</view>
        </view>
        <text class="watch-star on" data-code="{{item.code}}" catchtap="removeIndex">★</text>
      </view>
      <view class="idx-price-row">
        <text class="idx-price" style="color:{{item.color}}">{{item.price}}</text>
        <text class="idx-pct {{item.pctClass}}">{{item.changePct}}</text>
      </view>
      <view class="idx-chg" style="color:{{item.color}}">涨跌额 {{item.changeAmt}}</view>
    </view>
    <view class="empty" wx:if="{{indices.length === 0}}">
      暂无自选指数。在「今日行情 → 大盘指数」点击 ☆ 即可添加。
    </view>
  </block>

  <!-- 自选基金 -->
  <block wx:if="{{sub === 'fund'}}">
    <view class="card hold-card" wx:for="{{funds}}" wx:key="code">
      <view class="hold-title">
        <view style="flex:1">
          <view class="hold-name" data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goDetail">
            {{item.name}}
            <text class="tag brand" wx:if="{{item.isHeld}}">持仓</text>
            <text class="tag warn" wx:if="{{item.usingYesterday}}">按昨日净值</text>
          </view>
          <view class="idx-meta">{{item.code}} · 份额 {{item.shares}}</view>
        </view>
        <view>
          <view class="hold-amount">{{item.amount}}</view>
          <view class="hold-today" style="color:{{item.color}}">{{item.changePct}}</view>
        </view>
      </view>
      <view class="hold-stats">
        <view class="hold-stat"><text>净值</text><b>{{item.nav}}</b></view>
      </view>
      <view class="btn-row">
        <button class="btn small primary" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="goHoldings">加入持仓</button>
        <button class="btn small danger" wx:if="{{!item.isHeld}}" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="removeFund">取消自选</button>
      </view>
    </view>
    <view class="empty" wx:if="{{funds.length === 0}}">
      暂无自选基金。在「今日行情」中点击 ☆ 即可添加。
    </view>
  </block>
</view>
