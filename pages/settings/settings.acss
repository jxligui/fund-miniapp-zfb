.set-page { padding-bottom: 40rpx; }
.set-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.set-note { font-size: 22rpx; color: #8c8c8c; line-height: 1.7; margin: 8rpx 0; }
.set-stats { display: flex; margin: 12rpx 0; }
.stat-cell { flex: 1; text-align: center; }
.stat-value { display: block; font-size: 36rpx; font-weight: 700; }
.stat-label { display: block; font-size: 22rpx; color: #8c8c8c; margin-top: 4rpx; }
.set-search { flex: 1; margin: 0; }
.set-hint { flex: 1; }
.set-clear { width: 100%; margin-top: 12rpx; }
.set-textarea { height: 260rpx; font-size: 22rpx; }
.set-import-btn { width: 100%; margin-top: 12rpx; }

/* 类型筛选 */
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}
.type-chip {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #8c8c8c;
}

/* 基金条目 */
.fund-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}
.fund-main { display: flex; flex-direction: column; }
.fund-name { font-size: 27rpx; font-weight: 500; }
.fund-code { font-size: 22rpx; color: #8c8c8c; margin-top: 4rpx; }

/* 万能密码条目 */
.master-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #595959;
}
.master-no { flex: 1; }
.master-ok { color: #bfbfbf; font-size: 22rpx; margin-right: 24rpx; }
.master-del { color: #f5222d; }
