.set-page { padding-bottom: 40rpx; }

.set-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; color: #f8fafc; }
.set-note { font-size: 22rpx; color: #94a3b8; line-height: 1.7; margin: 8rpx 0; }
.set-clear { width: 100%; margin-top: 12rpx; }

/* 库统计：4 格等宽 + 竖分隔线 */
.set-stats {
  display: flex;
  align-items: stretch;
  margin: 20rpx 0 16rpx;
  padding: 20rpx 0;
  background: #1a2234;
  border-radius: 16rpx;
}
.stat-cell { flex: 1; text-align: center; }
.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #f59e0b;
  font-variant-numeric: tabular-nums;
}
.stat-label { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }
.stat-div { width: 1rpx; background: #334155; margin: 6rpx 0; }

/* 类型筛选 */
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}
.type-chip {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #1a2234;
  border: 1rpx solid #334155;
  color: #94a3b8;
}
.type-chip-on {
  background: #f59e0b;
  border-color: #f59e0b;
  color: #0f172a;
  font-weight: 600;
}

/* 同步进度条 */
.sync-progress { margin-top: 16rpx; }
.sync-bar {
  height: 12rpx;
  background: #1a2234;
  border-radius: 999rpx;
  overflow: hidden;
}
.sync-bar-fill {
  height: 100%;
  background: #f59e0b;
  border-radius: 999rpx;
}
.sync-pct {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
