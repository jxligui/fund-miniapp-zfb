<view class="page">
  <!-- PIN 解锁遮罩 -->
  <view class="lock-mask" a:if="{{!unlocked}}">
    <view class="lock-box">
      <view class="lock-title"><text>持仓基金已锁定</text></view>
      <view class="lock-sub"><text>请输入本地密码查看持仓数据</text></view>
      <input class="input" type="number" password maxlength="8" placeholder="请输入密码"
        value="{{pinInput}}" onInput="onUnlockInput" />
      <button class="btn btn-primary" style="width:100%" onTap="unlock">解锁</button>
    </view>
  </view>

  <block a:else>
    <!-- 总览 -->
    <view class="overview">
      <view class="ov-cell">
        <view class="ov-label"><text>总资产</text></view>
        <view class="ov-value ov-value-big"><text>{{totals.amountText}}</text></view>
      </view>
      <view class="ov-cell">
        <view class="ov-label"><text>今日盈亏</text></view>
        <view class="ov-value" style="color:{{totals.todayColor}}"><text>{{totals.todayText}}</text></view>
      </view>
      <view class="ov-cell">
        <view class="ov-label"><text>持有收益</text></view>
        <view class="ov-value" style="color:{{totals.profitColor}}"><text>{{totals.profitText}}</text></view>
      </view>
      <view class="ov-cell">
        <view class="ov-label"><text>收益率</text></view>
        <view class="ov-value" style="color:{{totals.profitColor}}"><text>{{totals.pctText}}</text></view>
      </view>
    </view>

    <!-- 分组栏 -->
    <scroll-view scroll-x class="group-bar" style="white-space:nowrap">
      <text class="group-tab {{activeGroup === item.key ? 'group-tab-on' : ''}}" a:for="{{groupTabs}}" a:key="key"
        data-key="{{item.key}}" onTap="switchGroup">{{item.name}} ({{item.count}})</text>
      <text class="group-tab" onTap="openGroupMgr">⚙ 管理</text>
    </scroll-view>

    <!-- 工具条 -->
    <view class="toolbar">
      <text class="hint" style="flex:1">持仓 {{visible.length}} 只</text>
      <button class="btn btn-small btn-primary" onTap="openAdd">＋ 添加</button>
      <button class="btn btn-small" onTap="openImport">批量导入</button>
      <button class="btn btn-small" onTap="refresh">刷新</button>
    </view>

    <!-- 未分组时提供批量分配 -->
    <view class="toolbar" a:if="{{activeGroup === '__none__' && visible.length > 0}}">
      <text class="hint" style="flex:1">已选 {{checked.length}} 只</text>
      <button class="btn btn-small" onTap="selectAll">全选/全不选</button>
      <button class="btn btn-small btn-primary" onTap="batchAssign">批量分配</button>
    </view>

    <!-- 持仓卡片 -->
    <view class="card hold-card" a:for="{{visible}}" a:key="code">
      <view class="hold-title">
        <view style="flex:1">
          <view class="hold-name" data-code="{{item.code}}" data-name="{{item.name}}" onTap="goDetail">
            <text>{{item.name}}</text>
            <text class="tag tag-brand" a:if="{{item.watch}}">自选</text>
            <text class="tag tag-warn" a:if="{{item.pending}}">待确认 ¥{{item.pendingText}}</text>
            <text class="tag" a:if="{{item.usingYesterday}}">按昨日净值</text>
          </view>
          <view class="idx-meta">
            <text>{{item.code}}</text>
            <text a:if="{{item.groupName}}"> · {{item.groupName}}</text>
          </view>
        </view>
        <view>
          <view class="hold-amount"><text>{{item.amountText}}</text></view>
          <view class="hold-today" style="color:{{item.todayColor}}"><text>{{item.todayText}}</text></view>
        </view>
      </view>

      <view class="hold-stats">
        <view class="hold-stat"><text>净值</text><text class="hold-stat-value">{{item.navText}}</text></view>
        <view class="hold-stat"><text>成本</text><text class="hold-stat-value">{{item.costText}}</text></view>
        <view class="hold-stat"><text>份额</text><text class="hold-stat-value">{{item.sharesText}}</text></view>
        <view class="hold-stat"><text>收益率</text><text class="hold-stat-value" style="color:{{item.profitColor}}">{{item.pctText}}</text></view>
      </view>

      <view class="btn-row">
        <button class="btn btn-small btn-primary" data-code="{{item.code}}" data-name="{{item.name}}" data-mode="add" catchTap="openTrade">＋ 加仓</button>
        <button class="btn btn-small" data-code="{{item.code}}" data-name="{{item.name}}" data-mode="reduce" catchTap="openTrade">－ 减仓</button>
        <button class="btn btn-small" data-code="{{item.code}}" catchTap="openMove">▦ 分组</button>
        <button class="btn btn-small btn-danger" data-code="{{item.code}}" data-name="{{item.name}}" catchTap="removeHolding">删除</button>
      </view>
    </view>

    <view class="empty" a:if="{{visible.length === 0}}"><text>
      暂无持仓基金。点击「＋ 添加」按金额添加，或用「批量导入」粘贴「基金代码 金额」。
    </text></view>
  </block>

  <!-- 添加/编辑弹层 -->
  <view class="modal" a:if="{{showAdd}}">
    <view class="modal-mask" onTap="closeAdd"></view>
    <view class="modal-body">
      <view class="modal-title"><text>添加基金（按金额）</text></view>
      <view class="field-label"><text>基金（代码或名称搜索）</text></view>
      <input class="input" placeholder="如 000001 或 华夏成长" value="{{query}}" onInput="onQuery" />
      <view class="suggest" a:for="{{suggest}}" a:key="code" data-code="{{item.code}}" data-name="{{item.name}}" onTap="pickSuggest">
        <text>{{item.name}}</text><text class="idx-meta">{{item.code}}</text>
      </view>
      <view class="field-label"><text>金额（元）</text></view>
      <input class="input" type="digit" placeholder="如 1000" value="{{amount}}" onInput="onAmount" />
      <view class="hint"><text>份额 = 金额 ÷ 最新净值，成本价取该净值；取不到净值时会记为待确认。</text></view>
      <view class="btn-row">
        <button class="btn btn-primary" onTap="saveAmount">保存</button>
        <button class="btn" onTap="closeAdd">取消</button>
      </view>
    </view>
  </view>

  <!-- 加减仓弹层 -->
  <view class="modal" a:if="{{showTrade}}">
    <view class="modal-mask" onTap="closeTrade"></view>
    <view class="modal-body">
      <view class="modal-title"><text>{{tradeMode === 'add' ? '加仓' : '减仓'}} · {{tradeName}}</text></view>
      <view class="field-label"><text>金额（元）</text></view>
      <input class="input" type="digit" placeholder="如 500" value="{{amount}}" onInput="onAmount" />
      <view class="hint"><text>按最新净值折算份额后加/减到持仓。</text></view>
      <view class="btn-row">
        <button class="btn btn-primary" onTap="saveTrade">确定</button>
        <button class="btn" onTap="closeTrade">取消</button>
      </view>
    </view>
  </view>

  <!-- 批量导入 -->
  <view class="modal" a:if="{{showImport}}">
    <view class="modal-mask" onTap="closeImport"></view>
    <view class="modal-body">
      <view class="modal-title"><text>批量导入（基金代码 + 金额）</text></view>
      <view class="hint"><text>每行一只，例如：000001 1000 / 161725 500.50</text></view>
      <textarea class="textarea" value="{{importText}}" onInput="onImportText"
        placeholder="000001 1000&#10;161725 500.50&#10;005827 2000"></textarea>
      <view class="btn-row">
        <button class="btn btn-primary" onTap="doImport">导入</button>
        <button class="btn" onTap="closeImport">取消</button>
      </view>
    </view>
  </view>

  <!-- 分组管理 -->
  <view class="modal" a:if="{{showGroupMgr}}">
    <view class="modal-mask" onTap="closeGroupMgr"></view>
    <view class="modal-body">
      <view class="modal-title"><text>自定义分组</text></view>
      <view class="field-label"><text>新建分组</text></view>
      <input class="input" placeholder="分组名称" value="{{newGroupName}}" onInput="onNewGroupName" />
      <button class="btn btn-primary btn-small" onTap="createGroup">新建</button>

      <view class="group-item" a:for="{{groups}}" a:key="*this">
        <input class="input" style="flex:1;margin:0" value="{{renameTarget === item ? renameValue : item}}"
          data-name="{{item}}" onInput="onRenameValue" onFocus="startRename" />
        <button class="btn btn-small" data-name="{{item}}" onTap="doRename">改名</button>
        <button class="btn btn-small btn-danger" data-name="{{item}}" onTap="deleteGroup">删除</button>
      </view>
      <view class="hint"><text>删除分组后其中的基金变为「未分组」，不会删除基金。</text></view>
      <view class="btn-row"><button class="btn" onTap="closeGroupMgr">关闭</button></view>
    </view>
  </view>

  <!-- 移动到分组 -->
  <view class="modal" a:if="{{showMove}}">
    <view class="modal-mask" onTap="closeMove"></view>
    <view class="modal-body">
      <view class="modal-title"><text>移到分组 · {{tradeName}}</text></view>
      <view class="group-item" data-key="__none__" onTap="onMoveTarget">
        <text class="move-pick {{moveTarget === '__none__' ? 'move-pick-on' : ''}}">未分组</text>
      </view>
      <view class="group-item" a:for="{{groups}}" a:key="*this" data-key="{{item}}" onTap="onMoveTarget">
        <text class="move-pick {{moveTarget === item ? 'move-pick-on' : ''}}">{{item}}</text>
      </view>
      <view class="btn-row">
        <button class="btn btn-primary" onTap="confirmMove">确定</button>
        <button class="btn" onTap="closeMove">取消</button>
      </view>
    </view>
  </view>
</view>
