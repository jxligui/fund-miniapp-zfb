/* 锁屏遮罩（深色主题） */
.lock-mask {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.lock-box {
  width: 600rpx;
  background: #222735;
  border: 1rpx solid #334155;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}
.lock-title { font-size: 34rpx; font-weight: 600; text-align: center; color: #f8fafc; }
.lock-sub { font-size: 24rpx; color: #94a3b8; text-align: center; margin: 10rpx 0 20rpx; }
