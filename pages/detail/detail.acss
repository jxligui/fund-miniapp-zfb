.d-title { font-size: 34rpx; font-weight: 600; }
.d-code { font-size: 24rpx; color: #8c8c8c; margin-top: 4rpx; }
.d-nav { font-size: 56rpx; font-weight: 700; margin-top: 20rpx; font-variant-numeric: tabular-nums; }
.d-date { font-size: 24rpx; color: #8c8c8c; margin-top: 4rpx; }
.d-section { font-size: 26rpx; color: #8c8c8c; margin-bottom: 16rpx; }

.spans { display: flex; flex-wrap: wrap; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f5f6f8; }
.span { width: 33.33%; text-align: center; padding: 8rpx 0; }
.span-label { font-size: 22rpx; color: #8c8c8c; }
.span-value { font-size: 28rpx; font-weight: 600; margin-top: 4rpx; }

.chart { margin-top: 12rpx; }
.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  height: 240rpx;
}
.chart-bar { flex: 1; border-radius: 2rpx 2rpx 0 0; min-height: 4rpx; }
.chart-axis {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #bfbfbf;
  margin-top: 8rpx;
}
