.set-page { padding-bottom: 40rpx; }
.set-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; color: #f8fafc; }
.set-note { font-size: 22rpx; color: #94a3b8; line-height: 1.7; margin: 8rpx 0; }
.set-stats { display: flex; margin: 16rpx 0; }
.stat-cell { flex: 1; text-align: center; }
.stat-value { display: block; font-size: 36rpx; font-weight: 700; color: #f59e0b; font-variant-numeric: tabular-nums; }
.stat-label { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }
.set-search { flex: 1; margin: 0; }
.set-hint { flex: 1; }
.set-clear { width: 100%; margin-top: 12rpx; }
.set-textarea { height: 260rpx; font-size: 22rpx; }
.set-import-btn { width: 100%; margin-top: 12rpx; }

/* 类型筛选 */
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}
.type-chip {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #1a2234;
  border: 1rpx solid #334155;
  color: #94a3b8;
}
.type-chip-on {
  background: #f59e0b;
  border-color: #f59e0b;
  color: #0f172a;
  font-weight: 600;
}

/* 基金条目 */
.fund-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #2a3448;
}
.fund-main { display: flex; flex-direction: column; }
.fund-name { font-size: 27rpx; font-weight: 500; color: #f8fafc; }
.fund-code { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; font-variant-numeric: tabular-nums; }

/* 万能密码条目 */
.master-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #cbd5e1;
}
.master-no { flex: 1; }
.master-ok { color: #64748b; font-size: 22rpx; margin-right: 24rpx; }
.master-del { color: #ef4444; }
