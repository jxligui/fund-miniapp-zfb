<view class="page">
  <view class="sub-tabs">
    <view class="sub-tab {{sub === 'index' ? 'sub-tab-on' : ''}}" data-sub="index" onTap="switchSub"><text>自选大盘指数</text></view>
    <view class="sub-tab {{sub === 'fund' ? 'sub-tab-on' : ''}}" data-sub="fund" onTap="switchSub"><text>自选基金</text></view>
  </view>

  <!-- 自选大盘指数 -->
  <block a:if="{{sub === 'index'}}">
    <view class="card idx-card" a:for="{{indices}}" a:key="code">
      <view class="idx-head">
        <view>
          <view class="idx-name"><text>{{item.name}}</text></view>
          <view class="idx-meta"><text>{{item.code}} · {{item.category}}</text></view>
        </view>
        <text class="watch-star watch-star-on" data-code="{{item.code}}" catchTap="removeIndex">★</text>
      </view>
      <view class="idx-price-row">
        <text class="idx-price" style="color:{{item.color}}">{{item.price}}</text>
        <text class="idx-pct {{item.pctClass}}">{{item.changePct}}</text>
      </view>
      <view class="idx-chg" style="color:{{item.color}}"><text>涨跌额 {{item.changeAmt}}</text></view>
    </view>
    <view class="empty" a:if="{{indices.length === 0}}"><text>
      暂无自选指数。在「今日行情 → 大盘指数」点击 ☆ 即可添加。
    </text></view>
  </block>

  <!-- 自选基金（操作默认折叠，点 ⋯ 展开） -->
  <block a:if="{{sub === 'fund'}}">
    <view class="card hold-card" a:for="{{funds}}" a:key="code">
      <view class="hold-title">
        <view class="hold-info" data-code="{{item.code}}" data-name="{{item.name}}" onTap="goDetail">
          <view class="hold-name">
            <text>{{item.name}}</text>
            <text class="tag tag-brand" a:if="{{item.isHeld}}">持仓</text>
            <text class="tag tag-warn" a:if="{{item.usingYesterday}}">按昨日净值</text>
          </view>
          <view class="idx-meta"><text>{{item.code}} · 份额 {{item.shares}}</text></view>
        </view>
        <view class="hold-right">
          <view class="hold-amount"><text>{{item.amount}}</text></view>
          <view class="hold-today" style="color:{{item.color}}"><text>{{item.changePct}}</text></view>
        </view>
        <text
          class="hold-more {{expandedCode === item.code ? 'hold-more-on' : ''}}"
          catchTap="toggleActions" data-code="{{item.code}}">
          {{expandedCode === item.code ? '▲' : '▼'}}
        </text>
      </view>
      <view class="hold-stats">
        <view class="hold-stat"><text>净值</text><text class="hold-stat-value">{{item.nav}}</text></view>
      </view>
      <view class="btn-row" a:if="{{expandedCode === item.code}}">
        <button class="btn btn-small btn-primary" a:if="{{!item.isHeld}}" data-code="{{item.code}}" data-name="{{item.name}}" catchTap="goHoldings">加入持仓</button>
        <button class="btn btn-small btn-danger" a:if="{{!item.isHeld}}" data-code="{{item.code}}" data-name="{{item.name}}" catchTap="removeFund">取消自选</button>
        <view class="hint" a:if="{{item.isHeld}}" style="flex:1"><text>已在持仓中，请到「持仓」页管理（不能取消自选）。</text></view>
      </view>
    </view>
    <view class="empty" a:if="{{funds.length === 0}}"><text>
      暂无自选基金。在「今日行情」中点击 ☆ 即可添加。
    </text></view>
  </block>
</view>
