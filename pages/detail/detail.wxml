<view class="page">
  <view class="card" wx:if="{{detail}}">
    <view class="d-title">{{detail.name || name}}</view>
    <view class="d-code">{{code}}</view>
    <view class="d-nav">{{detail.latestNavText}}</view>
    <view class="d-date">净值日期 {{detail.latestDate}}</view>

    <view class="spans">
      <view class="span" wx:for="{{spans}}" wx:key="key">
        <view class="span-label">{{item.label}}</view>
        <view class="span-value" style="color:{{item.color}}">{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{detail && detail.trend.length > 1}}">
    <view class="d-section">近半年净值走势</view>
    <view class="chart">
      <view class="chart-bars">
        <view class="chart-bar" wx:for="{{detail.trend}}" wx:key="d"
          style="height:{{item.h}}%;background:{{item.c}}"></view>
      </view>
      <view class="chart-axis">
        <text>{{detail.trend[0].d}}</text>
        <text>{{detail.trend[detail.trend.length - 1].d}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !detail}}">
    详情加载失败，请稍后重试。
  </view>
  <view class="empty" wx:if="{{loading}}">加载中…</view>
</view>
