/* ============================================================
   基金小助理 · 深色金融设计系统
   依据 ui-ux-pro-max 设计系统生成：
   Minimalism & Swiss Style × Fintech Dark
   背景 #0F172A · 卡片 #222735 · 主色金 #F59E0B · 红涨绿跌
   8rpx 间距节奏 · 24rpx 圆角 · 单 class 选择器（支付宝限制）
   ============================================================ */

page {
  background: #0f172a;
  color: #f8fafc;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;
}

.page { min-height: 100vh; padding-bottom: 40rpx; }

/* ---------- 卡片 ---------- */
.card {
  background: #222735;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  border: 1rpx solid #334155;
}

/* ---------- 顶部二级标签 ---------- */
.sub-tabs {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 24rpx 12rpx;
  background: #0f172a;
  white-space: nowrap;
}
.sub-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #94a3b8;
  background: #1a2234;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}
.sub-tab-on {
  color: #f59e0b;
  background: #2a2415;
  border-color: #f59e0b;
  font-weight: 600;
}

/* ---------- 指数卡片 ---------- */
.idx-card { margin: 12rpx 24rpx; }
.idx-head { display: flex; align-items: flex-start; justify-content: space-between; }
.idx-name { font-size: 30rpx; font-weight: 600; color: #f8fafc; }
.idx-meta { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }
.idx-price-row { display: flex; align-items: baseline; margin-top: 16rpx; }
.idx-price { font-size: 48rpx; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -1rpx; }
.idx-pct {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #1a2234;
  color: #94a3b8;
  font-variant-numeric: tabular-nums;
}
.idx-pct-up { background: rgba(239, 68, 68, 0.16); color: #ef4444; }
.idx-pct-down { background: rgba(34, 197, 94, 0.16); color: #22c55e; }
.idx-chg { font-size: 24rpx; color: #94a3b8; margin-top: 8rpx; font-variant-numeric: tabular-nums; }

/* ---------- 持仓卡片 ---------- */
.hold-card { margin: 12rpx 24rpx; }
.hold-title { display: flex; align-items: center; justify-content: space-between; }
.hold-name { font-size: 30rpx; font-weight: 600; color: #f8fafc; }
.hold-amount {
  font-size: 36rpx; font-weight: 700; text-align: right;
  font-variant-numeric: tabular-nums; color: #f8fafc;
}
.hold-today { font-size: 24rpx; text-align: right; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.hold-stats {
  display: flex; flex-wrap: wrap;
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx solid #334155;
}
.hold-stat {
  width: 50%; display: flex; justify-content: space-between;
  font-size: 22rpx; color: #94a3b8; padding: 4rpx 0;
  font-variant-numeric: tabular-nums;
}
.hold-stat-value { color: #f8fafc; font-weight: 600; }

/* ---------- 徽标 ---------- */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #1a2234;
  color: #94a3b8;
  margin-left: 10rpx;
}
.tag-brand { background: rgba(245, 158, 11, 0.16); color: #f59e0b; }
.tag-warn { background: rgba(250, 140, 22, 0.16); color: #fa8c16; }

/* ---------- 按钮 ---------- */
.btn {
  font-size: 26rpx;
  padding: 14rpx 30rpx;
  border-radius: 16rpx;
  background: #1a2234;
  border: 1rpx solid #334155;
  color: #f8fafc;
  line-height: 1.4;
}
.btn-primary {
  background: #f59e0b;
  border-color: #f59e0b;
  color: #0f172a;
  font-weight: 600;
}
.btn-danger { color: #ef4444; border-color: rgba(239, 68, 68, 0.4); }
.btn-small { font-size: 24rpx; padding: 10rpx 24rpx; }
.btn-row { display: flex; gap: 14rpx; flex-wrap: wrap; margin-top: 18rpx; }
.btn-disabled { opacity: 0.4; color: #94a3b8; }

/* ---------- 列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #222735;
  border-bottom: 1rpx solid #2a3448;
  margin: 0 24rpx 12rpx;
  border-radius: 24rpx;
}
.list-row-name { font-size: 28rpx; font-weight: 500; color: #f8fafc; }
.list-row-sub { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.list-row-right { text-align: right; font-variant-numeric: tabular-nums; }

/* ---------- 总览 ---------- */
.overview {
  display: flex;
  padding: 28rpx 24rpx;
  background: #222735;
  border: 1rpx solid #334155;
  border-radius: 24rpx;
  margin: 16rpx 24rpx;
}
.ov-cell { flex: 1; text-align: center; }
.ov-label { font-size: 22rpx; color: #94a3b8; }
.ov-value {
  font-size: 30rpx; font-weight: 700; margin-top: 8rpx;
  font-variant-numeric: tabular-nums; color: #f8fafc;
}
.ov-value-big { font-size: 40rpx; }

/* ---------- 分组栏 ---------- */
.group-bar {
  display: flex;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: #0f172a;
  white-space: nowrap;
}
.group-tab {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #1a2234;
  color: #94a3b8;
}
.group-tab-on { background: #f59e0b; color: #0f172a; font-weight: 600; }

/* ---------- 输入 ---------- */
.input {
  font-size: 28rpx;
  padding: 20rpx 24rpx;
  background: #1a2234;
  border: 1rpx solid #334155;
  border-radius: 16rpx;
  margin: 12rpx 0;
  color: #f8fafc;
}
.textarea {
  font-size: 24rpx;
  width: 100%;
  height: 240rpx;
  padding: 20rpx 24rpx;
  background: #1a2234;
  border: 1rpx solid #334155;
  border-radius: 16rpx;
  box-sizing: border-box;
  margin: 12rpx 0;
  color: #f8fafc;
}
.field-label { font-size: 24rpx; color: #94a3b8; margin-top: 16rpx; }
.hint { font-size: 22rpx; color: #94a3b8; margin-top: 8rpx; line-height: 1.6; }

/* ---------- 空状态 ---------- */
.empty { text-align: center; color: #64748b; font-size: 26rpx; padding: 80rpx 40rpx; line-height: 1.8; }

/* ---------- 工具条 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #0f172a;
}

/* ---------- 弹层 ---------- */
.modal { position: fixed; inset: 0; z-index: 100; }
.modal-mask { position: absolute; inset: 0; background: rgba(2, 6, 23, 0.7); }
.modal-body {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 86vh;
  overflow-y: auto;
  background: #222735;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 56rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #475569;
}
.modal-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; color: #f8fafc; }
.suggest {
  background: #1a2234;
  border: 1rpx solid #334155;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.group-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.move-pick {
  font-size: 28rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: #1a2234;
  color: #cbd5e1;
  width: 100%;
  box-sizing: border-box;
}
.move-pick-on { background: #f59e0b; color: #0f172a; font-weight: 600; }
